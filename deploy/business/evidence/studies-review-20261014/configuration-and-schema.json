          {
            "field": "CERTNO",
            "op": "eq",
            "right_field": "study_cardno"
          },
          {
            "field": "OP_EM_NO",
            "op": "eq",
            "right_field": "study_op_em_hp_ex_no"
          },
          {
            "field": "OP_EM_MARK",
            "op": "eq",
            "right_field": "study_visit_type"
          },
          {
            "field": "study_chk_modality",
            "op": "eq",
            "value": "DR"
          },
          {
            "field": "checked_at",
            "op": "lt",
            "right_field": "UPDATE_TIME"
          }
        ]
      },
