    "recognition_confirmed",
    "coverage_confirmed"
  ],
  "obligation": {
    "mode": "verification",
    "sources": [
      {
        "node": "Settlements",
        "identity": "SettlementChecks"
      }
    ],
    "checks": [
      {
        "name": "category",
        "units": {
          "node": "Classification",
          "port": "data"
        },
        "results": [
          {
            "node": "Compare",
            "port": "data",
            "status_field": "category_status",
            "evidence_field": "evidence_ref"
          },
          {
            "node": "StudyRelevance",
            "port": "issues",
            "status": "uncompared",
            "reason_field": "study_relevance_reason",
            "fallback": true
          }
        ]
      },
      {
        "name": "quantity",
        "units": {
          "node": "Classification",
          "port": "data"
        },
        "results": [
          {
            "node": "Compare",
            "port": "data",
            "status_field": "quantity_status",
            "evidence_field": "evidence_ref"
          },
          {
            "node": "StudyRelevance",
            "port": "issues",
            "status": "uncompared",
            "reason_field": "study_relevance_reason",
            "fallback": true
          }
        ]
      },
      {
        "name": "fee",
        "units": {
          "node": "Classification",
          "port": "data"
        },
        "results": [
          {
            "node": "Compare",
            "port": "data",
            "status_field": "amount_status",
            "evidence_field": "evidence_ref"
          },
          {
            "node": "StudyRelevance",
            "port": "issues",
            "status": "uncompared",
            "reason_field": "study_relevance_reason",
            "fallback": true
          }
        ]
      }
    ],
    "dispositions": [
      {
        "node": "Studies",
        "port": "issues",
        "status": "uncompared",
        "reason": "incomplete_evidence"
      },
      {
        "node": "Series",
        "port": "issues",
        "status": "uncompared",
        "reason": "incomplete_evidence"
      },
      {
        "node": "Images",
        "port": "issues",
        "status": "uncompared",
        "reason": "incomplete_evidence"
      },
      {
        "node": "Observation",
        "port": "issues",
        "status": "uncompared",
        "reason": "incomplete_evidence"
      },
      {
        "node": "Classification",
        "port": "issues",
        "status_field": "classification_disposition",
        "reason_field": "classification_disposition_reason"
      }
    ]
  },
  "units": {
    "node": "Classification",
    "port": "data"
  },
  "result_unit_field": "unit_row_id",
  "checks": [
    {
      "name": "category",
      "label": "类别",
      "status": "category_status",
      "left": "target_category",
      "right": "recognized_category"
    },
    {
      "name": "quantity",
      "label": "数量",
      "status": "quantity_status",
      "left": "CNT",
      "right": "recognized_quantity",
      "difference": "difference_1"
    },
    {
      "name": "fee",
      "label": "折算金额",
      "status": "amount_status",
      "left": "settled_amount",
      "right": "observed_amount",
      "difference": "difference_2"
    }
  ],
  "example": {
