    {
      "id": "Compare",
      "kind": "compare",
      "label": "Compare",
      "config": {
        "comparisons": [
          {
            "left": "target_category",
            "right": "recognized_category",
            "mode": "exact",
            "output": "category_status"
          },
          {
            "left": "CNT",
            "right": "recognized_quantity",
            "mode": "numeric",
            "tolerance": 0,
            "output": "quantity_status"
          },
          {
            "left": "settled_amount",
            "right": "observed_amount",
            "mode": "numeric",
            "tolerance": 0,
            "output": "amount_status"
          }
        ],
        "calculations": [
          {
            "field": "_representative_row_id",
            "output": "unit_row_id",
            "operation": "copy"
          },
          {
            "output": "settled_amount",
            "operation": "expression",
            "expression": "CNT * PRIC"
          },
          {
