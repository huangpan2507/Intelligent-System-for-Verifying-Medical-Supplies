          },
          {
            "category": "其他",
            "continue": false
          }
        ],
        "business_guidance": "判断该条耗材的类别，不要仅凭手术名称把同一手术的全部耗材当成关节假体。\n明确的髋/膝关节假体或成套假体系统可归入对应类别，其他具体耗材归入其他。\n依据不足、相互矛盾或无法判断时保持无法确定；不根据数量、价格猜类别。\n请用简短中文说明可核对的依据，不需要内部推理过程。",
        "rules": [
          {
            "op": "contains_all",
            "keywords": [
              "人工",
              "髋关节"
            ],
            "category": "人工髋关节"
