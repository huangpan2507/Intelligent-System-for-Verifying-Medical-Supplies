        <mxCell id="arch-e-review" edge="1" parent="1" source="arch-review" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#526D82;strokeWidth=1.6;fontColor=#334E68;labelBackgroundColor=#FFFFFF;exitX=0.924;exitY=1;entryX=0.924;entryY=0;jumpStyle=arc;jumpSize=8;fontSize=17;fontFamily=Microsoft YaHei;" target="arch-task-manager" value="&lt;div style=&quot;font-size:17px;line-height:1.25;&quot;&gt;&lt;div&gt;提交：医院／医保结算时间／规则选择&lt;/div&gt;&lt;div&gt;查询：进度／汇总／明细证据&lt;/div&gt;&lt;/div&gt;">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="-165" y="-20" as="offset"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="arch-settlement" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fontColor=#243B53;align=left;verticalAlign=top;spacing=16;strokeWidth=1.5;fillColor=#E8F4F0;strokeColor=#A6BED3;fontSize=18;fontFamily=Microsoft YaHei;" value="&lt;div style=&quot;font-size:18px;line-height:1.25;&quot;&gt;&lt;div style=&quot;font-weight:bold;margin-bottom:6px;&quot;&gt;结算数据源&lt;/div&gt;&lt;div&gt;dwd_dp_settlement_info／约定接口&lt;/div&gt;&lt;div&gt;按医院及医保结算时间范围读取。&lt;/div&gt;&lt;div&gt;保存明细键、数量、单价与费用。&lt;/div&gt;&lt;div&gt;SETL_TIME须落实；不用UPDATE_TIME替代。源数据只读。&lt;/div&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="230" width="330" x="40" y="1140" as="geometry"/>
        </mxCell>
        <mxCell id="arch-cloud" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fontColor=#243B53;align=left;verticalAlign=top;spacing=16;strokeWidth=1.5;fillColor=#E8F4F0;strokeColor=#A6BED3;fontSize=18;fontFamily=Microsoft YaHei;" value="&lt;div style=&quot;font-size:18px;line-height:1.25;&quot;&gt;&lt;div style=&quot;font-weight:bold;margin-bottom:6px;&quot;&gt;现有影像云&lt;/div&gt;&lt;div&gt;通过检查API → 序列API→ 影像地址API&lt;/div&gt;&lt;div&gt;提供原始DICOM下载&lt;/div&gt;&lt;div&gt;长期保留原片及历史访问&lt;/div&gt;&lt;div&gt;按云端标识和UID反查&lt;/div&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="200" width="330" x="40" y="1450" as="geometry"/>
        </mxCell>
        <mxCell id="arch-access" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fontColor=#243B53;align=left;verticalAlign=top;spacing=16;strokeWidth=1.5;fillColor=#EDF5FC;strokeColor=#A6BED3;fontSize=18;fontFamily=Microsoft YaHei;" value="&lt;div style=&quot;font-size:18px;line-height:1.25;&quot;&gt;&lt;div style=&quot;font-weight:bold;margin-bottom:6px;&quot;&gt;结算范围与检查接口&lt;/div&gt;&lt;div&gt;01按医院＋医保结算时间分页取数，保存实际清单／快照；不纳入范围外结算。&lt;/div&gt;&lt;div&gt;03查检查记录；05查序列与地址。&lt;/div&gt;&lt;div&gt;03／05不下载DICOM；持续增量后期建设。&lt;/div&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="200" width="370" x="470" y="1140" as="geometry"/>
        </mxCell>
        <mxCell id="arch-orchestrator" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fontColor=#243B53;align=left;verticalAlign=top;spacing=16;strokeWidth=1.5;fillColor=#DAE9F5;strokeColor=#A6BED3;fontSize=18;fontFamily=Microsoft YaHei;" value="&lt;div style=&quot;font-size:18px;line-height:1.25;&quot;&gt;&lt;div style=&quot;font-weight:bold;margin-bottom:6px;&quot;&gt;固定快照执行｜00—08&lt;/div&gt;&lt;div&gt;从Run绑定的发布包构图，不读取草稿。&lt;/div&gt;&lt;div&gt;01封存结算清单；02跨页业务分组。&lt;/div&gt;&lt;div&gt;节点间只传引用及统计，逐组落库。&lt;/div&gt;&lt;div&gt;08核对完整覆盖并保存汇总。&lt;/div&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="208" width="398" x="878" y="1132" as="geometry"/>
        </mxCell>
        <mxCell id="arch-rules" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fontColor=#243B53;align=left;verticalAlign=top;spacing=16;strokeWidth=1.5;fillColor=#EDF5FC;strokeColor=#A6BED3;fontSize=18;fontFamily=Microsoft YaHei;" value="&lt;div style=&quot;font-size:18px;line-height:1.25;&quot;&gt;&lt;div style=&quot;font-weight:bold;margin-bottom:6px;&quot;&gt;平台规则目录与不可变发布包&lt;/div&gt;&lt;div&gt;草稿 → 校验 → 发布 → 显式启用。&lt;/div&gt;&lt;div&gt;固化图、参数、字典和运行构建摘要。&lt;/div&gt;&lt;div&gt;新任务绑定启用版本；旧任务不变。&lt;/div&gt;&lt;div&gt;事实依据另存；详见第7页。&lt;/div&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="200" width="370" x="470" y="1450" as="geometry"/>
        </mxCell>
        <mxCell id="arch-adapter" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fontColor=#243B53;align=left;verticalAlign=top;spacing=16;strokeWidth=1.5;fillColor=#EEE7F5;strokeColor=#A6BED3;fontSize=18;fontFamily=Microsoft YaHei;" value="&lt;div style=&quot;font-size:18px;line-height:1.25;&quot;&gt;&lt;div style=&quot;font-weight:bold;margin-bottom:6px;&quot;&gt;06 小模型识别请求管理与适配&lt;/div&gt;&lt;div&gt;管理request_id及服务任务号映射。&lt;/div&gt;&lt;div&gt;提交影像地址或清单引用、目标范围及识别配置。&lt;/div&gt;&lt;div&gt;查询或接收识别状态、结果和证据。&lt;/div&gt;&lt;div&gt;关联实际处理、排除及失败清单，经公共模块保存。&lt;/div&gt;&lt;div&gt;耗材种类、数量及费用比对由07完成。&lt;/div&gt;&lt;div&gt;按自研或外购契约接入模型。&lt;/div&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="242" width="388" x="880" y="1443" as="geometry"/>
        </mxCell>
        <mxCell id="arch-llm" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fontColor=#243B53;align=left;verticalAlign=top;spacing=16;strokeWidth=1.5;fillColor=#FFF6DF;strokeColor=#A6BED3;fontSize=18;fontFamily=Microsoft YaHei;" value="&lt;div style=&quot;font-size:18px;line-height:1.25;&quot;&gt;&lt;div style=&quot;font-weight:bold;margin-bottom:6px;&quot;&gt;大模型文本辅助&lt;/div&gt;&lt;div&gt;本期规则不能确认时保留待验证。&lt;/div&gt;&lt;div&gt;后期返回原文依据并由程序校验。&lt;/div&gt;&lt;div&gt;主键始终由程序保管。&lt;/div&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="180" width="340" x="1360" y="1140" as="geometry"/>
        </mxCell>
        <mxCell id="arch-small-model" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fontColor=#243B53;align=left;verticalAlign=top;spacing=16;strokeWidth=1.5;fillColor=#EEE7F5;strokeColor=#A6BED3;fontSize=18;fontFamily=Microsoft YaHei;" value="&lt;div style=&quot;font-size:18px;line-height:1.25;&quot;&gt;&lt;div style=&quot;font-weight:bold;margin-bottom:6px;&quot;&gt;小模型识别服务（CT／DR）&lt;/div&gt;&lt;div&gt;按地址从影像云下载DICOM；完成筛选、解码、预处理。&lt;/div&gt;&lt;div&gt;识别种类及约定范围数量；验证跨图关联去重。&lt;/div&gt;&lt;div&gt;返回状态、原始结果、证据及实际处理／排除／失败清单。&lt;/div&gt;&lt;div&gt;管理本次临时文件及服务并发。&lt;/div&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="262" width="340" x="1369" y="1438" as="geometry"/>
        </mxCell>
        <mxCell id="arch-db" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fontColor=#243B53;align=left;verticalAlign=top;spacing=16;strokeWidth=1.5;fillColor=#DFF0F5;strokeColor=#A6BED3;fontSize=18;fontFamily=Microsoft YaHei;" value="&lt;div style=&quot;font-size:18px;line-height:1.25;&quot;&gt;&lt;div style=&quot;font-weight:bold;margin-bottom:6px;&quot;&gt;PostgreSQL｜规则、任务、范围及证据&lt;/div&gt;&lt;div&gt;RuleDefinition／RuleRelease／ActiveRelease；保留发布完整副本及启用记录。&lt;/div&gt;&lt;div&gt;Task → Run（release_id、binding_id、job_id）→ 结算快照／核验单元。&lt;/div&gt;&lt;div&gt;模型请求、原始结果及汇总；正式发布不可变，试验兼容代码不保留。&lt;/div&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="175" width="790" x="470" y="1810" as="geometry"/>
        </mxCell>
        <mxCell id="arch-review" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fontColor=#243B53;align=left;verticalAlign=top;spacing=16;strokeWidth=1.5;fillColor=#E7F5EC;strokeColor=#A6BED3;fontSize=18;fontFamily=Microsoft YaHei;" value="&lt;div style=&quot;font-size:18px;line-height:1.25;&quot;&gt;&lt;div style=&quot;font-weight:bold;margin-bottom:6px;&quot;&gt;原监管系统｜业务配置与人工复核&lt;/div&gt;&lt;div&gt;仅配置：医院范围、医保结算时间范围、规则选择。&lt;/div&gt;&lt;div&gt;后端自动处理监管编号／去重标识；提交并查询进度、汇总与明细证据。&lt;/div&gt;&lt;div&gt;不维护具体规则；人工复核、业务处置及显式重新核验保留在监管系统。&lt;/div&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="160" width="790" x="470" y="550" as="geometry"/>
        </mxCell>
        <mxCell id="arch-boundary" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fontColor=#243B53;align=left;verticalAlign=top;spacing=16;strokeWidth=1.5;fillColor=#F5F7FA;strokeColor=#A6BED3;fontSize=18;fontFamily=Microsoft YaHei;" value="&lt;div style=&quot;font-size:18px;line-height:1.25;&quot;&gt;&lt;div style=&quot;font-weight:bold;margin-bottom:6px;&quot;&gt;目标边界与当前实现&lt;/div&gt;&lt;div&gt;监管仅三项业务配置；结算范围为[开始时间,结束时间)，03检查窗口不扩大结算对象。&lt;/div&gt;&lt;div&gt;正式任务使用受理时的发布包；保存草稿、发布、启用是三个动作，完整机制见第7页。&lt;/div&gt;&lt;div&gt;分页不拆散业务计数单元；病例核实依据另行关联，缺失标记未比较。&lt;/div&gt;&lt;div&gt;当前是独立节点的明细任务模拟；范围任务／规则发布尚待实现，试验旧版不做兼容。&lt;/div&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="222" width="1265" x="40" y="2015" as="geometry"/>
        </mxCell>
        <mxCell id="arch-task-manager" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fontColor=#243B53;align=left;verticalAlign=top;spacing=16;strokeWidth=1.5;fillColor=#DAE9F5;strokeColor=#A6BED3;fontSize=18;fontFamily=Microsoft YaHei;" value="&lt;div style=&quot;font-size:20px;line-height:1.25;&quot;&gt;&lt;div style=&quot;font-weight:bold;margin-bottom:6px;&quot;&gt;核验API与Worker｜本期模拟实现&lt;/div&gt;&lt;div&gt;API解析三项条件，在受理事务中绑定release_id和binding_id，保存Task／Run。&lt;/div&gt;&lt;div&gt;单Worker按run_id请求固定发布执行，登记唯一job_id；事务不跨HTTP。&lt;/div&gt;&lt;div&gt;Job与业务状态分别核对，08保存回执是完成依据。&lt;/div&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="175" width="790" x="470" y="885" as="geometry"/>
        </mxCell>
        <mxCell id="arch-e-start" edge="1" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#526D82;strokeWidth=1.6;fontColor=#334E68;labelBackgroundColor=#FFFFFF;entryX=0.5;entryY=0;jumpStyle=arc;jumpSize=8;fontSize=17;fontFamily=Microsoft YaHei;" target="arch-orchestrator" value="&lt;div style=&quot;font-size:17px;line-height:1.25;&quot;&gt;按run_id启动固定发布包／关联Job&lt;/div&gt;">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1077" y="1061.59" as="sourcePoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="regulator-api" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#EDF5FC;strokeColor=#A6BED3;strokeWidth=1.2;fontColor=#243B53;align=left;verticalAlign=top;spacing=18;fontSize=20;fontFamily=Microsoft YaHei;" value="&lt;div style=&quot;font-size:20px;line-height:1.25;&quot;&gt;&lt;div style=&quot;font-weight:bold;margin-bottom:6px;&quot;&gt;监管对接｜三个业务配置&lt;/div&gt;&lt;div&gt;输入：医院范围（string）、医保结算时间范围、规则选择（string）；编号／鉴权由后端协议管理。&lt;/div&gt;&lt;div&gt;示例：常州市第一人民医院／2024年6月—2025年8月／高值耗材智能体。&lt;/div&gt;&lt;div&gt;平台查询实际明细并保存清单；监管不必传detail_ids，不存具体筛选／比较规则。&lt;/div&gt;&lt;div&gt;返回受理、扫描／核验进度、汇总与分页明细证据；无数据不表示核验一致。&lt;/div&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="235" width="1700" x="40" y="3153" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="implementation" name="业务流程与节点说明">
    <mxGraphModel dx="3275" dy="1733" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1780" pageHeight="4862" background="#FFFFFF" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="title" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#EDF5FC;strokeColor=#A6BED3;strokeWidth=1.2;fontColor=#243B53;align=left;verticalAlign=top;spacing=18;fontSize=26;fontFamily=Microsoft YaHei;" value="&lt;div style=&quot;font-size:26px;line-height:1.25;&quot;&gt;&lt;div&gt;业务流程与节点说明｜一笔耗材核验任务怎样执行&lt;/div&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="65" width="1700" x="40" y="25" as="geometry"/>
        </mxCell>
        <mxCell id="subtitle" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#EDF5FC;strokeColor=#A6BED3;strokeWidth=1.2;fontColor=#243B53;align=left;verticalAlign=top;spacing=18;fontSize=26;fontFamily=Microsoft YaHei;" value="&lt;div style=&quot;font-size:20px;line-height:1.25;&quot;&gt;&lt;div style=&quot;font-weight:bold;margin-bottom:6px;&quot;&gt;本期模拟流程与边界&lt;/div&gt;&lt;div&gt;监管三项条件受理后固定release_id；00加载该发布包，01只查询范围内医保结算。&lt;/div&gt;&lt;div&gt;一个Run对应完整图Job；各阶段内部按页／核验单元处理，节点间传清单引用。&lt;/div&gt;&lt;div&gt;已实现三项范围模拟、固定发布Job、分页封存和单元汇总；上下文只传引用。&lt;/div&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="133" width="1700" x="40" y="120" as="geometry"/>
        </mxCell>
        <mxCell id="integration" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFF5E3;strokeColor=#A6BED3;strokeWidth=1.2;fontColor=#243B53;align=left;verticalAlign=top;spacing=18;fontSize=18;fontFamily=Microsoft YaHei;" value="&lt;div style=&quot;font-size:18px;line-height:1.25;&quot;&gt;&lt;div style=&quot;font-weight:bold;margin-bottom:6px;&quot;&gt;范围示例与平台规则&lt;/div&gt;&lt;div&gt;医院：常州市第一人民医院；医保结算：2024年6月—2025年8月；规则：高值耗材智能体。&lt;/div&gt;&lt;div&gt;01仅纳入该医院、该结算时间内的明细；03仅为这些明细查关联检查。&lt;/div&gt;&lt;div&gt;规则字符串选择平台已发布方案；具体筛选与比较规则不由监管保存。&lt;/div&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="231" width="820" x="920" y="2031" as="geometry"/>
        </mxCell>
        <mxCell id="contract" link="https://docs.apipost.net/docs/detail/6dfae9144079000?target_id=1204a95cb12101&amp;locale=zh-cn" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#EDF5FF;strokeColor=#A6BED3;strokeWidth=1.2;fontColor=#243B53;align=left;verticalAlign=top;spacing=18;fontSize=18;fontFamily=Microsoft YaHei;" value="&lt;div style=&quot;font-size:18px;line-height:1.25;&quot;&gt;&lt;div style=&quot;font-weight:bold;margin-bottom:6px;&quot;&gt;已核实的接口链｜按此参数衔接&lt;/div&gt;&lt;div&gt;检查：GET /api/v2/study/list → study_primary_id&lt;/div&gt;&lt;div&gt;序列：GET /api/v2/dicom/series-instance-uid → series_id&lt;/div&gt;&lt;div&gt;影像地址：GET /api/v2/storage/dicom/sop-instance-uid&lt;/div&gt;&lt;div&gt;传 series_id（可选 url_type）→ domain、file_path 与影像 UID&lt;/div&gt;&lt;div&gt;影像地址接口返回下载信息，需再请求下载地址才能取得文件。&lt;/div&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="205" width="820" x="920" y="2369" as="geometry"/>
        </mxCell>
        <mxCell id="access-output" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#EDF5FF;strokeColor=#A6BED3;strokeWidth=1.2;fontColor=#243B53;align=left;verticalAlign=top;spacing=18;fontSize=18;fontFamily=Microsoft YaHei;" value="&lt;div style=&quot;font-size:18px;line-height:1.25;&quot;&gt;&lt;div style=&quot;font-weight:bold;margin-bottom:6px;&quot;&gt;01输出｜已封存清单及小型统计&lt;/div&gt;&lt;div&gt;输入：task_id／run_id／release_id及已解析医院、医保结算时间边界。&lt;/div&gt;&lt;div&gt;稳定分页读取并校验范围、唯一键、冲突、字段及来源一致性依据。&lt;/div&gt;&lt;div&gt;逐页保存，全部成功后封存snapshot_id及实际明细清单。&lt;/div&gt;&lt;div&gt;输出引用和统计，02在完整清单上跨页组织业务单元。&lt;/div&gt;&lt;div&gt;分页中断不得封存；无源快照保证时，只能声称固定本次实际取得的数据。&lt;/div&gt;&lt;div&gt;默认重跑复用已封存结算快照；未封存必须明确重新取数。&lt;/div&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="308" width="820" x="40" y="2031" as="geometry"/>
        </mxCell>
        <mxCell id="request-map" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#EDF5FF;strokeColor=#A6BED3;strokeWidth=1.2;fontColor=#243B53;align=left;verticalAlign=top;spacing=18;fontSize=18;fontFamily=Microsoft YaHei;" value="&lt;div style=&quot;font-size:18px;line-height:1.25;&quot;&gt;&lt;div style=&quot;font-weight:bold;margin-bottom:6px;&quot;&gt;03 查询参数来源｜按更新后的字段清单&lt;/div&gt;&lt;div&gt;结算表 name → name；cardno → cardno；organ_code → organ_code&lt;/div&gt;&lt;div&gt;结算时间 SETL_TIME + 窗口配置 → begin_time、end_time（必填）。&lt;/div&gt;&lt;div&gt;SETL_TIME暂缺：记录待补充，暂停该时间窗口查询；UPDATE_TIME不作替代。&lt;/div&gt;&lt;div&gt;证件类型配置 → cardtype；确认为身份证时传 01&lt;/div&gt;&lt;div&gt;模态配置 → chk_modality，CT／DR 分别查询&lt;/div&gt;&lt;div&gt;就诊类型 op_em_hp_ex_mark → 同名参数（3 住院／1 门诊）&lt;/div&gt;&lt;div&gt;就诊编号 op_em_hp_ex_no → 同名参数；需核实实表存在且口径一致。&lt;/div&gt;&lt;div&gt;缺少可靠就诊编号时，仅作候选查询；不能用患者相同直接证明本次就诊。&lt;/div&gt;&lt;div&gt;RPT_NO 不作接口入参；organ_name 用于展示、核验。&lt;/div&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="308" width="820" x="40" y="2369" as="geometry"/>
        </mxCell>
        <mxCell id="handoff-04" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#EDF5FF;strokeColor=#A6BED3;strokeWidth=1.2;fontColor=#243B53;align=left;verticalAlign=top;spacing=18;fontSize=18;fontFamily=Microsoft YaHei;" value="&lt;div style=&quot;font-size:18px;line-height:1.25;&quot;&gt;&lt;div style=&quot;font-weight:bold;margin-bottom:6px;&quot;&gt;后期大模型分支→05｜本期规则不明直接标待验证交05&lt;/div&gt;&lt;div&gt;分支输入：原检查记录（study_primary_id、proj_name、ckpt_name）、目标关节及任务／结算关联。&lt;/div&gt;&lt;div&gt;模型返回：部位判定、原文依据和无法判断原因；检查主键由程序保管，不让模型生成或改写。&lt;/div&gt;&lt;div&gt;程序处理：复核字段、原文引用及已核实的词典映射，回填对应的原检查记录。&lt;/div&gt;&lt;div&gt;分支输出：保留的检查记录列表。每项含 study_primary_id、target_joint、task_id、run_id、结算快照引用及判定依据。&lt;/div&gt;&lt;div&gt;05 第一步：读取 study_primary_id，调用序列列表 API，取得 series_id 列表。&lt;/div&gt;&lt;div&gt;05 第二步：逐个以 series_id 调用影像地址 API，保留检查→序列→影像关联。&lt;/div&gt;&lt;div&gt;去向：相关／待验证交 05；大模型调用失败保留待验证；仅可靠确认整项无关才排除并留痕。&lt;/div&gt;&lt;div&gt;部位和依据用于内部筛选与审计，不代替 API 主键；只使用已核实的映射配置。&lt;/div&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="308" width="820" x="40" y="2802" as="geometry"/>
        </mxCell>
        <mxCell id="handoff-05" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#EDF5FF;strokeColor=#A6BED3;strokeWidth=1.2;fontColor=#243B53;align=left;verticalAlign=top;spacing=18;fontSize=18;fontFamily=Microsoft YaHei;" value="&lt;div style=&quot;font-size:18px;line-height:1.25;&quot;&gt;&lt;div style=&quot;font-weight:bold;margin-bottom:6px;&quot;&gt;05 输出｜影像地址清单及关联信息&lt;/div&gt;&lt;div&gt;清单：manifest_id；每项含 study_primary_id、series_id、影像 UID、原始 DICOM 地址。&lt;/div&gt;&lt;div&gt;关联：task_id、run_id、target_joint、结算快照引用（可多条）；保留序列结构及影像云来源。&lt;/div&gt;&lt;div&gt;清单校验：检查接口响应、必要字段、地址格式及返回 UID 的关联一致性；按影像 UID 去重。&lt;/div&gt;&lt;div&gt;职责边界：不下载文件、不读取 DICOM 头、不解码；不据此判断实际部位、质量或可解码性。&lt;/div&gt;&lt;div&gt;异常处理：接口失败、字段缺失或关联冲突，本期记录待核查；不记作植入物数量 0。&lt;/div&gt;&lt;div&gt;持久化：保存云端稳定引用、UID 及任务关联；06 另存实际输入清单并关联本清单，登记下载与处理状态。&lt;/div&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="257" width="820" x="920" y="2802" as="geometry"/>
        </mxCell>
        <mxCell id="quality-owner" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFF5E3;strokeColor=#A6BED3;strokeWidth=1.2;fontColor=#243B53;align=left;verticalAlign=top;spacing=18;fontSize=20;fontFamily=Microsoft YaHei;" value="&lt;div style=&quot;font-size:20px;line-height:1.25;&quot;&gt;&lt;div style=&quot;font-weight:bold;margin-bottom:6px;&quot;&gt;06 服务端处理｜本期基础识别&lt;/div&gt;&lt;div&gt;小模型服务下载DICOM、筛选元数据、解码预处理并按约定范围识别。&lt;/div&gt;&lt;div&gt;跨图关联去重及计数必须验证；本期未支持的实际部位、覆盖／可计数增强记未评估。&lt;/div&gt;&lt;div&gt;后台保存request_id、实际输入、服务任务号、原始结果、处理清单及必要版本。&lt;/div&gt;&lt;div&gt;同次执行临时文件可复用；执行结束、记录保存后清理。跨运行结果复用后期建设。&lt;/div&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="205" width="1700" x="40" y="3140" as="geometry"/>
        </mxCell>
        <mxCell id="audit-strip" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#EAF7F3;strokeColor=#A6BED3;strokeWidth=1.2;fontColor=#243B53;align=left;verticalAlign=top;spacing=18;fontSize=20;fontFamily=Microsoft YaHei;" value="&lt;div style=&quot;font-size:20px;line-height:1.25;&quot;&gt;&lt;div style=&quot;font-weight:bold;margin-bottom:6px;&quot;&gt;范围、版本与计数依据&lt;/div&gt;&lt;div&gt;三项受理条件→标准医院与绑定版本→实际明细／快照→检查／影像→模型请求→比较结果与汇总。&lt;/div&gt;&lt;div&gt;各批次使用同一规则版本；计数核实依据另行关联，不能默认成立；范围外结算不纳入。&lt;/div&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="129" width="1700" x="40" y="1777" as="geometry"/>
        </mxCell>
        <mxCell id="model-response-contract" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFF5E3;strokeColor=#A6BED3;strokeWidth=1.2;fontColor=#243B53;align=left;verticalAlign=top;spacing=18;fontSize=20;fontFamily=Microsoft YaHei;" value="&lt;div style=&quot;font-size:20px;line-height:1.25;&quot;&gt;&lt;div style=&quot;font-weight:bold;margin-bottom:6px;&quot;&gt;06 返回约定｜任务状态、输入完整性、比较适用性分开&lt;/div&gt;&lt;div&gt;关联：request_id标识我方逻辑识别请求，关联业务编号与提交配置；本期保存实际输入和结果，完整尝试账本后期建设。服务任务编号有则映射model_job_id；我方补齐内部关联，不要求算法或厂商返回全部业务编号。&lt;/div&gt;&lt;div&gt;执行：我方统一记录status／stage与逐计数单元状态，保留服务原始返回；本期保存原始状态，未知字段如实标记；完整attempt管理后期建设。错误由实际执行组件报告，调用超时不等于远端失败。&lt;/div&gt;&lt;div&gt;完整性：返回约定输入、实际处理、失败及排除清单；按算法计数单元判断，不用文件成功率代替。全部排除记无适用输入，不记植入数量0。&lt;/div&gt;&lt;div&gt;原始结果：raw_type、raw_count、计数粒度及依据；原始0保留，失败／未返回不补0；元数据与像素判定分别保存。&lt;/div&gt;&lt;div&gt;适用性：部位、覆盖、可计数性按实际能力返回；未支持记not_evaluated，仍无法判断记unknown。由07结合业务条件决定是否比较。&lt;/div&gt;&lt;div&gt;版本：模型来源、可核实的模型／预处理／接口版本、能力配置及验证依据；未提供记未知。以上为我方记录要求，对外按已验证契约映射，不能假定厂商全部返回。&lt;/div&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="261" width="1700" x="40" y="3375" as="geometry"/>
        </mxCell>
        <mxCell id="comparison-eligibility" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFF5E3;strokeColor=#A6BED3;strokeWidth=1.2;fontColor=#243B53;align=left;verticalAlign=top;spacing=18;fontSize=20;fontFamily=Microsoft YaHei;" value="&lt;div style=&quot;font-size:18px;line-height:1.25;&quot;&gt;&lt;div style=&quot;font-weight:bold;margin-bottom:6px;&quot;&gt;07 比较条件与输出｜数量关系不等于植入归属&lt;/div&gt;&lt;div&gt;类别对齐：依据已确认的结算目录与模型标签对应关系，使用统一耗材类别；映射不明则不比较该项，不临时猜测。&lt;/div&gt;&lt;div&gt;本期受控样本由业务／影像人员核实部位、覆盖和计数条件，结合规则保留依据；自动评估后期建设。&lt;br/&gt;比较范围：确认患者、任务关联、目标关节、检查时序（chk_dt对照SETL_TIME）与计数口径；按类别分别比较，有可靠侧别时按约定分组，不跨类别抵扣。&lt;/div&gt;&lt;div&gt;条件分开：种类和数量分别判断能否比较；适用输入与去重规则须明确。未支持能力记未评估，不默认通过，也不按自研／外购分层。&lt;/div&gt;&lt;div&gt;结果：种类＝一致／不一致／未比较；数量＝识别量大于／等于／小于结算量／未比较。可比时差值＝识别量－结算量。&lt;/div&gt;&lt;div&gt;疑点：目标部位未确认、关联不明或计数问题阻断相应比较；保留原始数值，未比较不填差值0。&lt;/div&gt;&lt;div&gt;少量判断：输入覆盖不足、处理不完整或证据不足时，不以较小数量直接告警；模型0不能自动证明未植入。&lt;/div&gt;&lt;div&gt;归属边界：识别更多可能含既往植入物（本院或外院）；数量关系不要求先分离既往植入物，也不能证明本次新增植入。&lt;/div&gt;&lt;div&gt;费用衔接：仅采用可比较的数量和能够对应的结算单价，规则计算折算金额；费用条件、公式与未比较原因见下方费用框。&lt;/div&gt;&lt;div&gt;留痕：原始结果与比较用数量分存，保存单位、去重依据、结算／影像关联、规则与模型版本。07不重新读片。&lt;/div&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="308" width="1700" x="40" y="3761.0" as="geometry"/>
        </mxCell>
        <mxCell id="result-disposition-closure" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFF5E3;strokeColor=#A6BED3;strokeWidth=1.2;fontColor=#243B53;align=left;verticalAlign=top;spacing=18;fontSize=20;fontFamily=Microsoft YaHei;" value="&lt;div style=&quot;font-size:20px;line-height:1.25;&quot;&gt;&lt;div style=&quot;font-weight:bold;margin-bottom:6px;&quot;&gt;08结果交接与重新核验&lt;/div&gt;&lt;div&gt;保存范围内逐明细结果、未比较原因、证据、run_id、规则及结果版本；公共模块汇总进度。&lt;/div&gt;&lt;div&gt;查询失败仅重新读取已保存结果，不重新识别；空范围、无适用耗材和无法比较分别表达。&lt;/div&gt;&lt;div&gt;差异为人工复核线索，识别更多可能含既往植入；金额差额不直接认定基金损失。&lt;/div&gt;&lt;div&gt;监管组织业务／影像复核，数据缺项交数据人员，技术失败交开发运维。&lt;/div&gt;&lt;div&gt;人工确认旧执行结束后新run_id从01重跑，明确数据重取与规则版本，保留清单差异及历史。&lt;/div&gt;&lt;div&gt;原医院和医保结算时间范围不自动扩大；节点续跑、自动恢复与跨运行复用后期建设。&lt;/div&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="360" width="1700" x="40" y="4462.0" as="geometry"/>
        </mxCell>
        <mxCell id="fee-comparison-rules" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#EAF7F3;strokeColor=#A6BED3;strokeWidth=1.2;fontColor=#243B53;align=left;verticalAlign=top;spacing=18;fontSize=20;fontFamily=Microsoft YaHei;" value="&lt;div style=&quot;font-size:20px;line-height:1.25;&quot;&gt;&lt;div style=&quot;font-weight:bold;margin-bottom:6px;&quot;&gt;07 费用计算与比较｜按结算单价折算，08保存，监管系统处置&lt;/div&gt;&lt;div&gt;读取与传递：01读取PRIC、DET_ITEM_FEE_SUMAMT和CNT；02保留逐明细金额、单价、计价单位及快照关联，作为07的结算基准。小模型只提供识别种类和数量，不产生价格。&lt;/div&gt;&lt;div&gt;比较单元：同一任务、同类耗材、同计数／计价单位且能够明确对应的明细或同价组；先去重与确认数量口径，再折算金额，不能把同一识别总量重复用于多条结算明细。&lt;/div&gt;&lt;div&gt;结算基准：结算金额＝对应明细DET_ITEM_FEE_SUMAMT（同价组按唯一明细求和）。按约定精度校验原明细费用是否等于CNT×PRIC；不符时保留原值，费用记未比较并交数据核查。&lt;/div&gt;&lt;div&gt;计算：折算金额＝用于比较的影像识别数量×对应PRIC；金额差额＝折算金额－结算金额。识别更多时照实折算，不将数量截断到结算数量。&lt;/div&gt;&lt;div&gt;结果：按约定金额精度／容差记录折算金额大于／等于／小于结算金额，或未比较；负差额表示结算金额更高，正差额表示折算金额更高。&lt;/div&gt;&lt;div&gt;价格限制：同类存在不同单价、组件／整套无法对应或识别结果无法分配到价格时，费用未比较；不擅自取平均价、最高价，也不按结算数量强行分配识别数量。&lt;/div&gt;&lt;div&gt;独立状态：缺单价／源金额／计价单位或数量不可比时，费用未比较并留原因；原始数量0保留，只有有效且可比的0才折算为0。费用失败不抹去已完成的种类／数量结果。&lt;/div&gt;&lt;div&gt;金额运算：程序使用十进制定点数，配置币种、单价精度、金额舍入与容差并保存版本；退费／冲销须按已确认口径处理，未确认前不按普通正向费用比较。&lt;/div&gt;&lt;div&gt;示例：结算数量2、PRIC＝10,000元、源金额20,000元；可比识别数量1→折算10,000元、差额－10,000元。证据充分时形成费用差异线索，不能直接认定损失10,000元。&lt;/div&gt;&lt;div&gt;解释边界：这是用结算单价对影像识别数量作金额换算，不是影像测得的价格或实际新增植入费用；可能包含既往植入。明细项目费用不自动等于医保基金实际支付额。&lt;/div&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="333" width="1700" x="40" y="4099.0" as="geometry"/>
        </mxCell>
        <mxCell id="detail-input" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#DAE9F5;strokeColor=#A6BED3;strokeWidth=1.2;fontColor=#243B53;align=left;verticalAlign=top;spacing=18;fontSize=26;fontFamily=Microsoft YaHei;" value="&lt;div style=&quot;font-size:26px;line-height:1.25;&quot;&gt;&lt;div&gt;节点详情①｜01—03：读取结算、筛选基准、查询候选检查&lt;/div&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="65" width="1700" x="40" y="1936" as="geometry"/>
        </mxCell>
        <mxCell id="detail-images" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#DAE9F5;strokeColor=#A6BED3;strokeWidth=1.2;fontColor=#243B53;align=left;verticalAlign=top;spacing=18;fontSize=26;fontFamily=Microsoft YaHei;" value="&lt;div style=&quot;font-size:26px;line-height:1.25;&quot;&gt;&lt;div&gt;节点详情②｜04—06：检查初筛、影像地址、模型输入与输出&lt;/div&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="65" width="1700" x="40" y="2707" as="geometry"/>
        </mxCell>
        <mxCell id="detail-results" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#DAE9F5;strokeColor=#A6BED3;strokeWidth=1.2;fontColor=#243B53;align=left;verticalAlign=top;spacing=18;fontSize=26;fontFamily=Microsoft YaHei;" value="&lt;div style=&quot;font-size:26px;line-height:1.25;&quot;&gt;&lt;div&gt;节点详情③｜07—08：比较条件、费用规则与异常闭环&lt;/div&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="65" width="1700" x="40" y="3666.0" as="geometry"/>
        </mxCell>
        <mxCell id="m0Uqv87WW3kWX2MK9X65-25" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=1.5;align=left;verticalAlign=top;spacing=12;fontSize=18;fontFamily=Microsoft YaHei;" value="&lt;div style=&quot;font-size:18px;line-height:1.25;&quot;&gt;&lt;div style=&quot;font-weight:bold;margin-bottom:6px;&quot;&gt;01 结算快照｜范围发现与封存&lt;/div&gt;&lt;div&gt;按标准医院与医保结算时间稳定分页。&lt;/div&gt;&lt;div&gt;校验范围、来源键、重复／冲突及SETL_TIME。&lt;/div&gt;&lt;div&gt;逐页保存，全部成功后封存清单／快照。&lt;/div&gt;&lt;div&gt;只传引用及统计；跨页业务分组由02完成。&lt;/div&gt;&lt;div&gt;范围外结算不加入，空范围独立记录。&lt;/div&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="260" width="430" x="8" y="494" as="geometry"/>
        </mxCell>
        <mxCell id="m0Uqv87WW3kWX2MK9X65-26" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=1.5;align=left;verticalAlign=top;spacing=16;fontSize=18;fontFamily=Microsoft YaHei;" value="&lt;div style=&quot;font-size:18px;line-height:1.25;&quot;&gt;&lt;div style=&quot;font-weight:bold;margin-bottom:6px;&quot;&gt;02 耗材筛选｜固定规则与业务单元&lt;/div&gt;&lt;div&gt;按发布包筛选医保支付人工髋／膝耗材。&lt;/div&gt;&lt;div&gt;保存入选／排除原因及逐明细费用。&lt;/div&gt;&lt;div&gt;完整清单按稳定业务键跨页分组；&lt;/div&gt;&lt;div&gt;不重复分配同一影像计数，不扩大范围。&lt;/div&gt;&lt;div&gt;输出核验单元引用，事实依据另行关联。&lt;/div&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="260" width="358" x="483" y="509" as="geometry"/>
        </mxCell>
        <mxCell id="m0Uqv87WW3kWX2MK9X65-27" link="https://docs.apipost.net/docs/detail/6dfae7d97c79000?locale=zh-cn&amp;target_id=444ee13" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=1.5;align=left;verticalAlign=top;spacing=16;fontStyle=0;fontSize=18;fontFamily=Microsoft YaHei;" value="&lt;div style=&quot;font-size:18px;line-height:1.25;&quot;&gt;&lt;div style=&quot;font-weight:bold;margin-bottom:6px;&quot;&gt;03 获取关联检查列表&lt;/div&gt;&lt;div&gt;仅为02入选结算查询检查记录。&lt;/div&gt;&lt;div&gt;按患者、医院、就诊及检查窗口查询；核对身份、模态和时间。&lt;/div&gt;&lt;div&gt;输出study_primary_id、检查时间及部位原文；不下载影像，不扩大结算范围。&lt;/div&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="215" width="375" x="889" y="532" as="geometry"/>
        </mxCell>
        <mxCell id="m0Uqv87WW3kWX2MK9X65-28" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=1.5;align=left;verticalAlign=top;spacing=16;fontStyle=0;fontColor=default;fontSize=18;fontFamily=Microsoft YaHei;" value="&lt;div style=&quot;font-size:18px;line-height:1.25;&quot;&gt;&lt;div style=&quot;font-weight:bold;margin-bottom:6px;&quot;&gt;04 检查部位初筛｜规则&lt;/div&gt;&lt;div&gt;输入检查记录、部位原文与目标关节。&lt;/div&gt;&lt;div&gt;确认相关：保留并交05。&lt;/div&gt;&lt;div&gt;确认整项无关：排除并留依据。&lt;/div&gt;&lt;div&gt;语义歧义／缺信息：待验证交05。&lt;/div&gt;&lt;div&gt;本期保留主键与任务关联。&lt;/div&gt;&lt;div&gt;大模型辅助为后期可选分支。&lt;/div&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="250" width="385" x="1305.5" y="530" as="geometry"/>
        </mxCell>
        <mxCell id="m0Uqv87WW3kWX2MK9X65-29" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=1.5;align=left;verticalAlign=top;spacing=16;fontSize=18;fontFamily=Microsoft YaHei;" value="&lt;div style=&quot;font-size:18px;line-height:1.25;&quot;&gt;&lt;div style=&quot;font-weight:bold;margin-bottom:6px;&quot;&gt;后期可选｜大模型解释文本&lt;/div&gt;&lt;div&gt;本期不启用该增强分支。&lt;/div&gt;&lt;div&gt;规则不能确认时，原记录标待验证交05。&lt;/div&gt;&lt;div&gt;后期返回部位判定与原文依据，由程序校验；主键保持不变。&lt;/div&gt;&lt;div&gt;仅可靠确认整项无关才排除并留痕。&lt;/div&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="235" width="350" x="1323" y="845" as="geometry"/>
        </mxCell>
        <mxCell id="m0Uqv87WW3kWX2MK9X65-30" link="https://docs.apipost.net/docs/detail/6dfaead25070000?target_id=11ffcb2c7120a1&amp;locale=zh-cn" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=1.5;align=left;verticalAlign=top;spacing=16;fontSize=18;fontFamily=Microsoft YaHei;" value="&lt;div style=&quot;font-size:18px;line-height:1.25;&quot;&gt;&lt;div style=&quot;font-weight:bold;margin-bottom:6px;&quot;&gt;05 获取影像地址与清单校验&lt;/div&gt;&lt;div&gt;以study_primary_id取序列列表，再以series_id取影像地址。&lt;/div&gt;&lt;div&gt;校验响应、地址及标识，按UID去重。&lt;/div&gt;&lt;div&gt;保留检查→序列→影像及结算任务关联，交06。&lt;/div&gt;&lt;div&gt;本节点不下载、不解码、不判实际部位或质量。&lt;/div&gt;&lt;div&gt;地址失效记录待核查；自动刷新重试后期建设。&lt;/div&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="300" width="350" x="1323" y="1173" as="geometry"/>
        </mxCell>
        <mxCell id="m0Uqv87WW3kWX2MK9X65-31" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=1.5;align=left;verticalAlign=top;spacing=16;fontSize=18;fontFamily=Microsoft YaHei;" value="&lt;div style=&quot;font-size:20px;line-height:1.25;&quot;&gt;&lt;div style=&quot;font-weight:bold;margin-bottom:6px;&quot;&gt;06 小模型识别调用与结果整理&lt;/div&gt;&lt;div&gt;程序保存request_id、输入与业务关联；调用小模型API，接收或查询结果。&lt;/div&gt;&lt;div&gt;小模型服务下载DICOM，筛选元数据、解码、预处理、识别及已验证计数。&lt;/div&gt;&lt;div&gt;返回原始种类／数量、状态、实际处理／排除／失败清单与证据。&lt;/div&gt;&lt;div&gt;本期验证跨图关联去重；失败不补0，未评估不默认通过，交07。&lt;/div&gt;&lt;div&gt;部位／覆盖／可计数性自动评估为后期增强。&lt;/div&gt;&lt;div&gt;服务管理同次临时文件；执行结束且留痕后清理，跨运行复用后期建设。&lt;/div&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="461" width="368" x="897" y="1150" as="geometry"/>
        </mxCell>
        <mxCell id="m0Uqv87WW3kWX2MK9X65-32" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=1.5;align=left;verticalAlign=top;spacing=16;fontSize=18;fontFamily=Microsoft YaHei;" value="&lt;div style=&quot;font-size:18px;line-height:1.25;&quot;&gt;&lt;div style=&quot;font-weight:bold;margin-bottom:6px;&quot;&gt;07 种类、数量与费用比对&lt;/div&gt;&lt;div&gt;核对关联、部位、时序、类别、处理状态及计数口径。&lt;/div&gt;&lt;div&gt;种类：一致／不一致／未比较。&lt;/div&gt;&lt;div&gt;数量：大于／等于／小于结算量，或未比较。&lt;/div&gt;&lt;div&gt;费用：可比识别量×对应单价，与结算金额比较。&lt;/div&gt;&lt;div&gt;输出结果、数值、差额、依据及未比较原因；失败不补0。&lt;/div&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="300" width="350" x="462" y="1173" as="geometry"/>
        </mxCell>
        <mxCell id="m0Uqv87WW3kWX2MK9X65-33" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=1.5;align=left;verticalAlign=top;spacing=16;fontSize=18;fontFamily=Microsoft YaHei;" value="&lt;div style=&quot;font-size:18px;line-height:1.25;&quot;&gt;&lt;div style=&quot;font-weight:bold;margin-bottom:6px;&quot;&gt;08 分批保存｜完整覆盖后完成&lt;/div&gt;&lt;div&gt;逐单元保存结果及逐明细关联。&lt;/div&gt;&lt;div&gt;核对封存清单的每条明细都有明确去向。&lt;/div&gt;&lt;div&gt;汇总按业务单元去重，短事务封存并完成。&lt;/div&gt;&lt;div&gt;空范围、未比较、失败分别表达。&lt;/div&gt;&lt;div&gt;Job成功不能替代业务保存回执。&lt;/div&gt;&lt;div&gt;查询只读已存结果，人工重跑产生新Run。&lt;/div&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="357" width="350" x="37" y="1173" as="geometry"/>
        </mxCell>
        <mxCell id="m0Uqv87WW3kWX2MK9X65-34" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F5F7FA;strokeColor=#B7C6D7;strokeWidth=1.5;fontColor=#263C53;align=left;verticalAlign=top;spacing=16;fontSize=18;fontFamily=Microsoft YaHei;" value="&lt;div style=&quot;font-size:18px;line-height:1.25;&quot;&gt;&lt;div style=&quot;font-weight:bold;margin-bottom:6px;&quot;&gt;实现分工｜独立节点，共享业务逻辑&lt;/div&gt;&lt;div&gt;00—08均为本项目自定义独立类型，可从Verification拖拽。&lt;/div&gt;&lt;div&gt;Langflow提供控件、连线和图执行；业务规则与HTTP适配由项目实现。&lt;/div&gt;&lt;div&gt;API绑定发布包，Worker只启动完整图，不逐节点调度。&lt;/div&gt;&lt;div&gt;一Run一图，各阶段分页／分组落库；不在图外按每页重复01—08。&lt;/div&gt;&lt;div&gt;试验通用组件及兼容分支已删除；范围任务仍待实现。&lt;/div&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="250" width="790" x="14" y="820" as="geometry"/>
        </mxCell>
