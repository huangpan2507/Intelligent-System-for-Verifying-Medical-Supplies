        <mxCell id="seq-mvp-11" edge="1" parent="1" style="html=1;strokeColor=#37658b;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;dashed=1;fontSize=17;fontFamily=Microsoft YaHei;" value="&lt;div style=&quot;font-size:17px;line-height:1.25;&quot;&gt;&lt;div&gt;返回状态、结果与证据&lt;/div&gt;&lt;/div&gt;">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="510" y="1120" as="sourcePoint"/>
            <mxPoint x="190" y="1120" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="seq-mvp-execute" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;strokeColor=#6c8ebf;fillColor=#dae8fc;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=18;fontFamily=Microsoft YaHei;" value="&lt;div style=&quot;font-size:16px;line-height:1.25;&quot;&gt;&lt;div style=&quot;font-weight:bold;margin-bottom:6px;&quot;&gt;固定发布图&lt;/div&gt;&lt;div&gt;00校验；01封存；02分组&lt;/div&gt;&lt;div&gt;03—08按单元核验保存&lt;/div&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="70" width="240" x="1390" y="740" as="geometry"/>
        </mxCell>
        <mxCell id="seq-mvp-note" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;strokeColor=#6c8ebf;fillColor=#dae8fc;fillColor=#f5f5f5;strokeColor=#b3b3b3;fontSize=18;fontFamily=Microsoft YaHei;" value="&lt;div style=&quot;font-size:18px;line-height:1.25;&quot;&gt;&lt;div&gt;发布图禁止规则覆盖与冻结跳过；按run_id唯一登记Job，回执丢失先查原记录。&lt;/div&gt;&lt;div&gt;后台队列不等于模型自动恢复；受理未知先确认，08业务保存回执才表示完成。&lt;/div&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="64" width="1620" x="80" y="1200" as="geometry"/>
        </mxCell>
        <mxCell id="reliability-r7-c0" parent="1" style="whiteSpace=wrap;html=1;align=left;spacing=12;fillColor=#fff2cc;strokeColor=#c8c8c8;fontFamily=Microsoft YaHei;fontSize=18;" value="&lt;div style=&quot;font-size:18px;line-height:1.25;&quot;&gt;&lt;div&gt;执行中断或调用超时&lt;/div&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="82" width="450" x="40" y="1905" as="geometry"/>
        </mxCell>
        <mxCell id="reliability-r7-c1" parent="1" style="whiteSpace=wrap;html=1;align=left;spacing=12;fillColor=#fff2cc;strokeColor=#c8c8c8;fontFamily=Microsoft YaHei;fontSize=18;" value="&lt;div style=&quot;font-size:17px;line-height:1.25;&quot;&gt;失联／超时记录失败或待确认；先查原Job与模型请求。原run_id终结后重试也不产生第二次执行。&lt;/div&gt;" vertex="1">
          <mxGeometry height="82" width="1250" x="490" y="1905" as="geometry"/>
        </mxCell>
      <mxCell id="seq-job-ack" edge="1" parent="1" style="html=1;strokeColor=#37658b;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;dashed=1;fontSize=17;fontFamily=Microsoft YaHei;" value="&lt;div style=&quot;font-size:17px;line-height:1.25;&quot;&gt;返回唯一job_id&lt;/div&gt;">
          <mxGeometry relative="1" as="geometry">
